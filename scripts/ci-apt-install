#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  scripts/ci-apt-install package...

Installs Debian packages on a GitHub-hosted runner, skipping any already
installed. The network steps (index update and package download) each run
under a timeout and are retried; the runner image's apt mirror list puts
azure.archive.ubuntu.com first, and when that mirror stalls apt can wait on it
until the job times out. After a failed attempt the Azure mirror is dropped
from the list, so the retry fetches from the remaining mirrors.
USAGE
}

if [ "$#" -eq 0 ]; then
  usage >&2
  exit 2
fi

missing=()
for package in "$@"; do
  if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -qx 'install ok installed'; then
    missing+=("$package")
  fi
done
if [ "${#missing[@]}" -eq 0 ]; then
  echo "already installed: $*"
  exit 0
fi

mirrors=/etc/apt/apt-mirrors.txt
apt=(apt-get -o Acquire::Retries=2 -o Acquire::http::Timeout=20 -o Acquire::https::Timeout=20)

for attempt in 1 2 3; do
  if sudo timeout 120 "${apt[@]}" update &&
    sudo timeout 240 "${apt[@]}" install -y --no-install-recommends --download-only "${missing[@]}"; then
    # Packages are already downloaded, so unpacking needs no network and is not
    # interrupted by a timeout.
    sudo "${apt[@]}" install -y --no-install-recommends --no-download "${missing[@]}"
    exit 0
  fi
  echo "apt attempt $attempt failed for: ${missing[*]}" >&2
  if [ -f "$mirrors" ] && grep -q 'azure\.archive\.ubuntu\.com' "$mirrors" &&
    grep -v 'azure\.archive\.ubuntu\.com' "$mirrors" | grep -q '[^[:space:]]'; then
    echo "dropping azure.archive.ubuntu.com from $mirrors" >&2
    sudo sed -i '/azure\.archive\.ubuntu\.com/d' "$mirrors"
  fi
  sleep $((attempt * 5))
done
exit 1
